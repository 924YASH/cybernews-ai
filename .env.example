# GEMINI_API_KEY: Required for server-side Google Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT="3000"

# Optional: Google Safe Browsing API v4 key for live website threat lookups
GOOGLE_SAFE_BROWSING_API_KEY=""

# Optional: Abuse.ch URLhaus Auth-Key for live malware URL reputation checks
URLHAUS_AUTH_KEY=""

# Optional: Firebase Web SDK configuration (leave empty to use browser-local history mode)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

